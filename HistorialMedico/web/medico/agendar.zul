                               <listcell zclass = "mycss-listcell" style="font-size:12px ;background:#EBF5FB;border: 1px solid #cfcfcf;" >
                               
                                
                                    <div style="display: flex; flex-direction: column; height: 100%;">
                                        <div style="flex: 1;">
                                            <textbox readonly="true"  style="font-size:12px ;background:#EBF5FB"
                                                     class="form-control form-control-sm" 
                                                     width="100%"
                                                     multiline="true"
                                                     rows="3"
                                                     value="@bind(each.c15)"
                                                     onDoubleClick="@command('modelPaciente',valor=each,sillon='15')"
                                            />
                        
                                        </div> <!-- espacio arriba -->
                                        <hbox spacing="1px" pack="center">
                                            <button width="100%" label="Eliminar"  tooltiptext="Eliminar paciente" 
                                                    class="btn-danger-zk" iconSclass="z-icon-trash-o" 
                                                    onClick="@command('eliminarPaciente',valor=each,sillon='15')" />
                                            <button width="100%"  label="Atender"
                                                    class="btn-success-zk"    
                                                    iconSclass="z-icon-plus-circle"                                            
                                                    onClick="@command('eliminarPaciente',valor=each,sillon='15')" />
                                        
                                        </hbox>
                                    </div>
                                </listcell>
                         

                            
                                
                            </listitem>
                        </template>
                    </listbox>
                
<!--                <div  class="contenedorInfoInputs">                     
                            
                        
                    <div class="inputCalendar"  align="center" >
                        <button 
                            class="inputGroupBtn"
                            onClick="@command('guardar')"
                            iconSclass="z-icon-save"
                            tooltiptext="Buscar">
                            Guardar Perfil
                        </button> 
                    </div>     
                </div>-->
            </div>
        </div>
        
    </div>
    
</zk>




