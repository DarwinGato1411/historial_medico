<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="../resources/css/boostrap/bootstrap.css"?>  
<?link rel="stylesheet" type="text/css" href="../resources/css/style.css"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>

<zk  contentStyle="overflow:auto"  class="border border-primary">

  

    <div  self="@define(content)" class="contenedorEmpresa"  apply="org.zkoss.bind.BindComposer" 
          viewModel="@id('vm') @init('com.ec.controlador.AgendarController')" > 
        <div  class="contenedorInfoCalendar" >
            <div class="titulo">
                AGENDAMIENTO DE CITAS
            </div>
         
            <div class="infoEmpresa"  >
                <div class="contenedorInfoInputs"  >
                     
                    <div class="inputCalendar"  >
                        <!--<label value="Calendario de citas médicas:"/>-->
                        <calendar weekOfYear="true" id="idCalendar" height="200px" width="100%"
                                  value="@bind(vm.fechaAgendar)" 
                                  onChange="@command('agendar')" 
                                  onDayClick="@command('clickEnFecha', fecha=event.data)"
                        />
                           
                        <div   >
                            
                            <div  class="contenedorInfoH" >
                                <div class="titulo">
                                    Datos del paciente (Hora de atención: )
                                    <label value="1718264839001" 
                                           class="form-control form-control-sm"
                                           tooltiptext="Ruc (1718264839001)"
                                           width="90%"                    />
                                </div>
           
                                <div class="infoEmpresa">
                                    <div  class="contenedorInfoInputs">
                     
                                        <div class="inputGroup"  >
                                            <label value="RUC:"/>
                                            <textbox value="1718264839001" 
                                                     placeholder="RUC"
                                                     class="form-control form-control-sm"
                                                     tooltiptext="Ruc (1718264839001)"
                                                     width="90%"                    />
                                        </div>                     
                                        <div class="inputGroup"  >
                                            <label value="Nombre:"/>
                                            <textbox value="Darwin Vinicio Morocho " 
                                                     placeholder="Nombre"
                                                     class="form-control form-control-sm"
                                                     tooltiptext="Nombre"
                                                     width="90%"                    />
                                        </div>
                          
                                        <div style="display: flex; justify-content: center; align-items: flex-end; height: 100%;">
                                            <hbox spacing="5px" pack="center">
                                            
                                            
                                                <button width="100%"  label="Odontograma"
                                                        class="btn-primary-zk"    
                                                        iconSclass="z-icon-plus-circle"                                            
                                                        onClick="@command('eliminarPaciente',valor=each,sillon='1')" />
                                                <button width="100%"  label="Historial"
                                                        class="btn-info-zk"    
                                                        iconSclass="z-icon-eye"                                          
                                                        onClick="@command('eliminarPaciente',valor=each,sillon='1')" />
                                                <button width="100%"  label="Facturar"
                                                        class="btn-success-zk"    
                                                        iconSclass="z-icon-file-o"                                            
                                                        onClick="@command('eliminarPaciente',valor=each,sillon='1')" />
                                        
                                            </hbox>
                                        </div>
                                    </div>
                                </div>
            
            
                            </div>  
                        </div> 
                    </div> 
                </div> 
                    
                       
            </div>
                                             
               
                <div class="inputCalendar" >
                <listbox model="@load(vm.listaAgenda)" style="overflow-x:auto;"
                             nonselectableTags="*" mold="paging" pageSize="15"
                              width="100%" height="100%" 
                  >
                               
                        <custom-attributes org.zkoss.zul.listbox.rod="true"/>        
                        <!-- CONGELAR LAS PRIMERAS 5 COLUMNAS -->
                        <frozen columns="2"/>   
                    <listhead  > 
<!--                        <listheader label="" width="45px" />
                        <listheader label="" width="45px" />-->
                        <listheader label="Inicio" width="100px" />                                                                        
                        <listheader label="Fin"  width="100px" /> 
                        <listheader label="SILLON 1" width="200px" />
                        <listheader label="SILLON 2" width="200px" />
                        <listheader label="SILLON 3" width="200px" />
                        <listheader label="SILLON 4" width="200px" />
                        <listheader label="SILLON 5" width="200px" />
                        <listheader label="SILLON 6" width="200px" />
